POSTGRES_VERSION=16
PGMQ_VERSION=v1.9.0

CHANNELS='["imessage"]'

# This is the bots configuration for the Telegram Gateway
BOTS_CONFIG='[{"connector_id": "tg1", "bot_token": "0123456789:ABCDEFG", "cw_account_id": "123", "cw_inbox_id": "888"}, {"connector_id": "tg2", "bot_token": "1234567890:BCDEFGH", "cw_account_id": "123", "cw_inbox_id": "999"}]'

# This is the bots configuration for the iMessage Gateway
IMESSAGE_BOTS_CONFIG='[{"connector_id": "im1", "server_url": "https://bluebubbles.example.com", "server_password": "YOUR_BLUEBUBBLES_PASSWORD", "cw_account_id": "123", "cw_inbox_id": "777"}]'

# This is the bots configuration for the Signal Gateway.
# `number` is the Signal account registered/linked inside the
# signal-cli-rest-api container; `api_url` is how the gateway reaches it.
# Signal has no inbound webhook — the gateway long-polls GET /v1/receive,
# so the container must run with MODE=normal (or json-rpc).
#   - Gateway in the SAME docker network: use http://signal-cli-rest-api:8080
#   - Gateway in a SEPARATE network/stack: use http://host.docker.internal:8080
#     (requires the container's port published to the host; on a Linux host
#      also add `extra_hosts: ["host.docker.internal:host-gateway"]` to the
#      gateway service).
SIGNAL_BOTS_CONFIG='[{"connector_id": "sig1", "number": "+<TELNUMBER>", "api_url": "http://host.docker.internal:8080", "cw_account_id": "123", "cw_inbox_id": "666"}]'

# Encryption key that Telegram (or other adapters that support such keys)
# will send to the API in the header
SECRET_TOKEN=ABCDEFGHIJKLMNOPQRSTUVWXYZ

# smtp_password defaults to imap_password. Add "smtp_password": "..." to smtp block if different.
MAILBOXES_CONFIG='[{"connector_id": "e1", "cw_account_id": "24", "cw_inbox_id": "12", "imap_username": "your_email@example.com", "imap_password": "16-digitPasswordNoSpaces", "smtp": {"smtp_username": "your_email@example.com", "smtp_from": "your_email@example.com"}}]'

# Take from Profile Settings -> Access Token (at the very bottom)
CHATWOOT_ACCESS_TOKEN=YOUR_CW_TOKEN

# Link to the domain where your Chatwoot is hosted
CHATWOOT_BASE_URL=https://your-domain-name.com

# Database settings
DB_USER=postgres
DB_PASS=YOUR_SUPER_SECRET_DB_PASS
DB_HOST=localhost # Or name of the docker container
DB_PORT=5432
DB_NAME=your_db_name
TEST_CONTAINER=true

INCOMING_QUEUE_NAME=to_cw
OUTGOING_QUEUE_NAME=from_cw

# Main domain for webhook configuration
WH_DOMAIN=https://your_domain.com

# Group for plugin auto-discovery
GROUP=helpline.channel_adapters

# In Production, it should be changed to PROD. Only "LOCAL", "DEV", "STAGE" and "PROD" are allowed
ENVIRONMENT=LOCAL

# Number of workers to run the app with.
# If WORKERS is 0 or 1, the app will run with a single process (event loop mode).
# If WORKERS >= 2, the app will run in multiprocess mode with one parent process
# and the specified number of worker processes (e.g., WORKERS=3 means 1 parent process and 3 worker processes).
WORKERS=1

LOG_LEVEL=DEBUG # INFO, WARNING, ERROR, etc

ANONYMIZE_USERS=True

# OpenTelemetry settings
OTEL_ENABLED=true
OTEL_SERVICE_NAME=service_name
# Leave empty to disable OTLP export and send traces only to Sentry
OTEL_ENDPOINT=
OTEL_INSECURE=true
OTEL_SAMPLING_RATIO=1.0

# Sentry settings
SENTRY_DSN=
SENTRY_RELEASE=0.0.1
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false
